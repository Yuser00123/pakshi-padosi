# ---- Model (open-weight Gemma via any OpenAI-compatible endpoint) ------------------------
LLM_PROVIDER=openai                       # openai (compatible endpoints) | google (google-genai SDK) | mock (no model)
LLM_API_KEY=                              # Google AI Studio key (free tier) — or any provider's key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemma-4-31b-it                  # also tested: gemma-4-26b-a4b-it; offline: LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=gemma3:4b
# LLM_MAX_TOKENS=6000                     # Gemma 4 thinks before it answers; thinking eats tokens
# LLM_EXTRA_BODY={"reasoning_effort":"none"}   # optional experiment to switch thinking off (auto-retried without it if rejected)

# ---- App -----------------------------------------------------------------------------------
TOWN_DEFAULT=Raebareli                    # what the location box shows first
TOWN_COORDS=26.2087, 81.2186              # its coordinates, so the default needs no geocoder
REPO_URL=https://github.com/Yuser00123/pakshi-padosi
# GBIF_ENOUGH_RECORDS=1000                # widen the search radius (25→50→100 km) until this many seasonal records
PORT=7860
GRADIO_ANALYTICS_ENABLED=False
